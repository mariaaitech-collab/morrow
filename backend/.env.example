# Brandora Backend Environment Variables
# Copy this file to .env and fill in your real values

# Where the app runs (required). Every URL below is built from these two with
# ${APP_BASE_URL} / ${API_BASE_URL}; to move to another port or a public domain,
# change only these lines.
#   APP_BASE_URL  the frontend users open (Vite dev server; it proxies /api)
#   API_BASE_URL  this backend
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# Optional overrides (default to the values above):
# FRONTEND_URL=        where users land after login/connect flows
# CORS_ORIGINS=        comma-separated allowed origins

SECRET_KEY=change-this-to-a-random-secret-string

# Firebase Firestore (the database). The backend uses Application Default
# Credentials (for local development, run `gcloud auth application-default login`).
FIREBASE_PROJECT_ID=morrow-2916d
# Optional: only if you created a named database instead of "(default)".
FIRESTORE_DATABASE=
# Local testing against the Firestore emulator instead (no key needed):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Facebook (Meta) App
# Create at: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Enter the same value under Facebook Login > Settings > Valid OAuth Redirect URIs.
FACEBOOK_REDIRECT_URI=${APP_BASE_URL}/auth/callback/facebook
# Graph API version for every Facebook/Instagram call (match your app dashboard)
META_API_VERSION=v26.0

# LinkedIn App
# Create at: https://www.linkedin.com/developers/apps/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=${APP_BASE_URL}/auth/callback/linkedin

# Instagram (uses Facebook Graph API)
# Create at: https://developers.facebook.com/apps/
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=${APP_BASE_URL}/auth/callback/instagram

# TikTok App (Login Kit for Web, v2 endpoints)
# Create at: https://developers.tiktok.com/
# TIKTOK_CLIENT_KEY: TikTok's name for the app id ("Client Key"). A Sandbox app
#   has its own key and secret (the sandbox key starts with "sb"); use those
#   while the app is in Sandbox mode.
# TIKTOK_CLIENT_SECRET: used only by this backend for the token exchange.
#   Never put it in the frontend or in any VITE_ variable.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI: where TikTok sends the user after they log in. It must
#   - be identical, byte for byte, to a Redirect URI registered under Login Kit
#     in the TikTok portal (scheme, host, port, path and trailing slash count);
#   - start with https:// (TikTok rejects http for Web apps);
#   - end with /api/auth/tiktok/callback, the route this backend handles.
#   Built from APP_BASE_URL, so while that is http://localhost TikTok login
#   cannot work: TikTok only accepts a public https redirect URI. Set
#   APP_BASE_URL to a public https domain, then register this exact value.
#   Open the app on that same domain: starting a connection sets a state
#   cookie there that the callback checks. Users then land on FRONTEND_URL.
TIKTOK_REDIRECT_URI=${APP_BASE_URL}/api/auth/tiktok/callback
# Optional: comma-separated TikTok scopes, no spaces. List ONLY scopes added to
# the app in the TikTok portal; any other scope makes the login fail.
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish

# ---------------------------------------------------------------------------
# AI image generation (Create page + Auto Scheduler "Option B")
# ---------------------------------------------------------------------------
# pollinations | none. "none" turns AI images off; the scheduler then offers
# only Upload Media. Defaults to pollinations.
IMAGE_PROVIDER=pollinations
# Optional Pollinations secret key (sk_..., from https://enter.pollinations.ai/keys).
# Empty: the anonymous free tier, limited to 1 image every 45 seconds per
# server IP (HTTP 402 FREE_LIMIT past that). Set: no limit, billed to the
# key's Pollen balance. Keep it server-side only.
IMAGE_API_KEY=
# Site name drawn bottom-right on every AI-generated image (semi-transparent
# white, scaled to the image width). Leave empty for no watermark.
WATERMARK_TEXT=Morrow

# ---------------------------------------------------------------------------
# AI Auto-Responder (comments + DMs)
# ---------------------------------------------------------------------------
# Public https base URL of this backend, shown in the dashboard as the webhook
# callback URL. Defaults to API_BASE_URL. Platforms cannot deliver webhooks to
# localhost, so set this in production (Meta comment polling works without it).
# PUBLIC_BACKEND_URL=

# Meta (Facebook + Instagram) webhooks. The verify token is any random string;
# enter the same value in Meta App Dashboard > Webhooks.
META_WEBHOOK_VERIFY_TOKEN=change-me-random-string
# Signs webhook POSTs. Defaults to FACEBOOK_CLIENT_SECRET when empty.
META_APP_SECRET=
INSTAGRAM_APP_SECRET=
# Extra permissions requested at connect time so BrandAura can read and reply
# to comments/DMs. Set to an empty value if your LIVE Meta app has not been
# approved for them yet (Development-mode apps can use them for app roles).
META_ENGAGEMENT_SCOPES=pages_manage_metadata,pages_messaging,instagram_manage_comments,instagram_manage_messages

# Reject unsigned webhook POSTs (keep true outside local experiments).
WEBHOOK_REQUIRE_SIGNATURE=true

# Rule-based auto-responder (no AI). Similarity cutoff for misspellings (0-100).
RESPONDER_FUZZY_CUTOFF=85
# A keyword match needs this many keyword hits, or one hit on a keyword of at
# least RESPONDER_STRONG_KEYWORD_LEN characters (rules can allow single hits).
RESPONDER_MIN_KEYWORD_HITS=2
RESPONDER_STRONG_KEYWORD_LEN=6
# Flood protection: automatic replies per workspace per hour.
RESPONDER_HOURLY_REPLY_LIMIT=200
# Platforms the AI Responder works on (facebook, instagram, linkedin, tiktok).
# Comments from any other platform are logged and ignored; connecting and
# publishing to it still work. Add linkedin or tiktok here once their comment
# API access is approved.
RESPONDER_PLATFORMS=facebook,instagram

# Poll Facebook/Instagram comments via the Graph API (needed while the Meta app
# is in Development mode). Set false once the app is Live and webhooks arrive.
META_POLLING_ENABLED=true
META_POLL_INTERVAL=30
