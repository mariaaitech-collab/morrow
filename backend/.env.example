# Brandora Backend Environment Variables
# Copy this file to .env and fill in your real values

SECRET_KEY=change-this-to-a-random-secret-string

# Facebook (Meta) App
# Create at: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5173/auth/callback/facebook

# LinkedIn App
# Create at: https://www.linkedin.com/developers/apps/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/callback/linkedin

# Instagram (uses Facebook Graph API)
# Create at: https://developers.facebook.com/apps/
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/auth/callback/instagram
